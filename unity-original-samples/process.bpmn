<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_1"
  targetNamespace="http://example.com/bpmn">

  <bpmn2:process id="Process_1" name="Order Delivery Process" isExecutable="false">

    <bpmn2:laneSet id="LaneSet_1">

      <bpmn2:lane id="Lane_Customer" name="CUSTOMER">
        <bpmn2:flowNodeRef>StartEvent_1</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_CreateOrder</bpmn2:flowNodeRef>
      </bpmn2:lane>

      <bpmn2:lane id="Lane_DeliveryManager" name="DELIVERY_MANAGER">
        <bpmn2:flowNodeRef>Task_CheckOrder</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_OrderValid</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_PrepareDelivery</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RejectOrder</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_1</bpmn2:flowNodeRef>
      </bpmn2:lane>

    </bpmn2:laneSet>

    <bpmn2:startEvent id="StartEvent_1" name="Order received">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:task id="Task_CreateOrder" name="Create order">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_CheckOrder" name="Check order">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:exclusiveGateway
      id="Gateway_OrderValid"
      name="Order valid?">

      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Valid</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Invalid</bpmn2:outgoing>

    </bpmn2:exclusiveGateway>

    <bpmn2:task id="Task_PrepareDelivery" name="Prepare delivery">
      <bpmn2:incoming>Flow_Valid</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_RejectOrder" name="Reject order">
      <bpmn2:incoming>Flow_Invalid</bpmn2:incoming>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:endEvent id="EndEvent_1" name="Process completed">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- CONNECTIONS -->

    <bpmn2:sequenceFlow
      id="Flow_1"
      sourceRef="StartEvent_1"
      targetRef="Task_CreateOrder" />

    <bpmn2:sequenceFlow
      id="Flow_2"
      sourceRef="Task_CreateOrder"
      targetRef="Task_CheckOrder" />

    <bpmn2:sequenceFlow
      id="Flow_3"
      sourceRef="Task_CheckOrder"
      targetRef="Gateway_OrderValid" />

    <bpmn2:sequenceFlow
      id="Flow_Valid"
      name="Yes"
      sourceRef="Gateway_OrderValid"
      targetRef="Task_PrepareDelivery" />

    <bpmn2:sequenceFlow
      id="Flow_Invalid"
      name="No"
      sourceRef="Gateway_OrderValid"
      targetRef="Task_RejectOrder" />

    <bpmn2:sequenceFlow
      id="Flow_4"
      sourceRef="Task_PrepareDelivery"
      targetRef="EndEvent_1" />

    <bpmn2:sequenceFlow
      id="Flow_5"
      sourceRef="Task_RejectOrder"
      targetRef="EndEvent_1" />

  </bpmn2:process>

  <!-- GRAFICA / POSIZIONAMENTO -->

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane
      id="BPMNPlane_1"
      bpmnElement="Process_1">

      <!-- LANES -->

      <bpmndi:BPMNShape
        id="Lane_Customer_di"
        bpmnElement="Lane_Customer"
        isHorizontal="true">

        <dc:Bounds
          x="100"
          y="100"
          width="1000"
          height="180" />

      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="Lane_DeliveryManager_di"
        bpmnElement="Lane_DeliveryManager"
        isHorizontal="true">

        <dc:Bounds
          x="100"
          y="280"
          width="1000"
          height="260" />

      </bpmndi:BPMNShape>

      <!-- NODES -->

      <bpmndi:BPMNShape
        id="StartEvent_1_di"
        bpmnElement="StartEvent_1">

        <dc:Bounds
          x="170"
          y="170"
          width="36"
          height="36" />

      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="Task_CreateOrder_di"
        bpmnElement="Task_CreateOrder">

        <dc:Bounds
          x="260"
          y="145"
          width="120"
          height="80" />

      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="Task_CheckOrder_di"
        bpmnElement="Task_CheckOrder">

        <dc:Bounds
          x="440"
          y="330"
          width="120"
          height="80" />

      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="Gateway_OrderValid_di"
        bpmnElement="Gateway_OrderValid"
        isMarkerVisible="true">

        <dc:Bounds
          x="620"
          y="345"
          width="50"
          height="50" />

      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="Task_PrepareDelivery_di"
        bpmnElement="Task_PrepareDelivery">

        <dc:Bounds
          x="740"
          y="300"
          width="140"
          height="80" />

      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="Task_RejectOrder_di"
        bpmnElement="Task_RejectOrder">

        <dc:Bounds
          x="740"
          y="420"
          width="140"
          height="80" />

      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape
        id="EndEvent_1_di"
        bpmnElement="EndEvent_1">

        <dc:Bounds
          x="980"
          y="355"
          width="36"
          height="36" />

      </bpmndi:BPMNShape>

      <!-- EDGES -->

      <bpmndi:BPMNEdge
        id="Flow_1_di"
        bpmnElement="Flow_1">

        <di:waypoint x="206" y="188" />
        <di:waypoint x="260" y="188" />

      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Flow_2_di"
        bpmnElement="Flow_2">

        <di:waypoint x="380" y="185" />
        <di:waypoint x="410" y="185" />
        <di:waypoint x="410" y="370" />
        <di:waypoint x="440" y="370" />

      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Flow_3_di"
        bpmnElement="Flow_3">

        <di:waypoint x="560" y="370" />
        <di:waypoint x="620" y="370" />

      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Flow_Valid_di"
        bpmnElement="Flow_Valid">

        <di:waypoint x="670" y="370" />
        <di:waypoint x="705" y="370" />
        <di:waypoint x="705" y="340" />
        <di:waypoint x="740" y="340" />

      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Flow_Invalid_di"
        bpmnElement="Flow_Invalid">

        <di:waypoint x="645" y="395" />
        <di:waypoint x="645" y="460" />
        <di:waypoint x="740" y="460" />

      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Flow_4_di"
        bpmnElement="Flow_4">

        <di:waypoint x="880" y="340" />
        <di:waypoint x="930" y="340" />
        <di:waypoint x="930" y="373" />
        <di:waypoint x="980" y="373" />

      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge
        id="Flow_5_di"
        bpmnElement="Flow_5">

        <di:waypoint x="880" y="460" />
        <di:waypoint x="930" y="460" />
        <di:waypoint x="930" y="373" />
        <di:waypoint x="980" y="373" />

      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn2:definitions>